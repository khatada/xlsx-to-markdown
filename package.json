{
  "name": "xlsx-to-md",
  "version": "0.1.0",
  "description": "Convert XLSX files to Markdown, handling mixed content (tables and paragraphs)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt src/ --check",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "xlsx",
    "excel",
    "markdown",
    "converter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
